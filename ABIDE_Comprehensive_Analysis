+alldata <- merged_data %>% 
+  select(SUB_ID, SITE_ID, DX_GROUP, DSM_IV_TR, AGE_AT_SCAN, SEX, AVG_SOCIAL, AVG_COMM)
+
+# Convert to integers for MANCOVA
+alldata$AVG_SOCIAL_INT <- round(alldata$AVG_SOCIAL * 10)
+alldata$AVG_COMM_INT <- round(alldata$AVG_COMM * 10)
+
+if(!is.null(varimax_scores) && !is.null(promax_scores)) {
+  # Combine with PCA scores
+  varimax_alldata <- cbind(alldata, varimax_scores[, 1:min(top_pcs, ncol(varimax_scores))])
+  promax_alldata <- cbind(alldata, promax_scores[, 1:min(top_pcs, ncol(promax_scores))])
+  
+  # Remove any V1 column if present
+  if("V1" %in% names(varimax_alldata)) varimax_alldata <- varimax_alldata %>% select(-V1)
+  if("V1" %in% names(promax_alldata)) promax_alldata <- promax_alldata %>% select(-V1)
+  
+  safe_write_csv(varimax_alldata, "varimax_alldata.csv")
+  safe_write_csv(promax_alldata, "promax_alldata.csv")
+  
+} else {
+  cat("Warning: PCA scores not available. Using base dataset only.\n")
+  varimax_alldata <- promax_alldata <- alldata
+}
+
+# =============================================================================
+# Step 6: Exploratory Data Analysis (EDA)
+# =============================================================================
