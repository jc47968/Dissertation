+
+print(ggplot(data_long, aes(x = as.factor(DX_GROUP), y = Score, fill = Variable)) +
+  geom_boxplot(alpha = 0.7) +
+  scale_x_discrete(labels = c("1" = "Autism", "2" = "Control")) +
+  labs(title = "Social and Communication Scores by Diagnostic Group",
+       x = "Diagnostic Group", y = "Score", fill = "Measure") +
+  theme_minimal())
+dev.off()
+
+cat("EDA visualizations saved to 05_eda/\n")
+
+# =============================================================================
+# Step 7: MANCOVA Analysis
+# =============================================================================
+cat("\n=== Step 7: MANCOVA Analysis ===\n")
+
+if(!is.null(varimax_scores) && ncol(varimax_alldata) > 10) {
+  # Define dependent variables
+  dependent_vars <- paste0("PC", 1:min(top_pcs, sum(grepl("^PC", names(varimax_alldata)))))
+  
+  if(length(dependent_vars) > 0) {
+    cat("Performing MANCOVA with", length(dependent_vars), "principal components...\n")
+    
+    # Create MANCOVA formulas
+    mancova_formula_comm <- as.formula(
+      paste("cbind(", paste(dependent_vars, collapse = ", "), 
+            ") ~ DX_GROUP * AVG_COMM_INT + AGE_AT_SCAN*DX_GROUP + AGE_AT_SCAN*AVG_COMM_INT +
+            SEX*DX_GROUP + SEX*AVG_COMM_INT + AGE_AT_SCAN * SEX")
+    )
+    
+    mancova_formula_social <- as.formula(
+      paste("cbind(", paste(dependent_vars, collapse = ", "), 
+            ") ~ DX_GROUP * AVG_SOCIAL_INT + AGE_AT_SCAN*DX_GROUP + AGE_AT_SCAN*AVG_SOCIAL_INT +
+            SEX*DX_GROUP + SEX*AVG_SOCIAL_INT + AGE_AT_SCAN * SEX")
+    )
+    
+    # Perform MANCOVA analyses
+    tryCatch({
+      # Communication MANCOVA
+      varimax_mancova_comm <- manova(mancova_formula_comm, data = varimax_alldata)
+      varimax_summary_comm <- summary(varimax_mancova_comm, test = "Wilks")
+      varimax_aov_comm <- summary.aov(varimax_mancova_comm)
+      
+      # Social MANCOVA  
+      varimax_mancova_social <- manova(mancova_formula_social, data = varimax_alldata)
+      varimax_summary_social <- summary(varimax_mancova_social, test = "Wilks")
+      varimax_aov_social <- summary.aov(varimax_mancova_social)
+      
+      # Save results
+      mancova_comm_df <- as.data.frame(varimax_summary_comm$stats)
+      mancova_social_df <- as.data.frame(varimax_summary_social$stats)
+      
+      safe_write_csv(mancova_comm_df, "mancova_communication_results.csv", "06_mancova")
+      safe_write_csv(mancova_social_df, "mancova_social_results.csv", "06_mancova")
+      
+      cat("MANCOVA analysis completed successfully.\n")
+      
+    }, error = function(e) {
+      cat("Error in MANCOVA analysis:", e$message, "\n")
+    })
+  }
+} else {
+  cat("Warning: Insufficient data for MANCOVA analysis.\n")
+}
+
+# =============================================================================
+# Step 8: Support Vector Machine (SVM) Classification
+# =============================================================================
+cat("\n=== Step 8: SVM Classification ===\n")
+
+if(!is.null(varimax_scores) && nrow(varimax_alldata) > 50) {
+  cat("Preparing data for SVM classification...\n")
+  
+  # Prepare datasets for SVM
+  varimax_alldata$DX_GROUP <- as.factor(varimax_alldata$DX_GROUP)
+  pc_columns <- names(varimax_alldata)[grepl("^PC", names(varimax_alldata))][1:min(top_pcs, sum(grepl("^PC", names(varimax_alldata))))]
+  
+  # Create train/test split
+  varimax_alldata <- varimax_alldata %>% mutate(RowID = row_number())
+  
+  testing_data <- varimax_alldata %>%
+    filter(DX_GROUP %in% c("1", "2")) %>%
+    group_by(DX_GROUP) %>%
+    slice_sample(prop = test_proportion) %>%
+    ungroup()
+  
+  training_data <- varimax_alldata %>%
+    filter(!RowID %in% testing_data$RowID) %>%
+    select(-RowID)
+  
+  testing_data <- testing_data %>% select(-RowID)
+  
+  cat("Training set size:", nrow(training_data), "\n")
+  cat("Testing set size:", nrow(testing_data), "\n")
+  
+  # Train SVM model
+  tryCatch({
+    cat("Training SVM model...\n")
+    svm_model <- train_svm(training_data, pc_columns)
+    
+    # Make predictions
+    predictions <- predict(svm_model, testing_data[, pc_columns])
+    prediction_probs <- predict(svm_model, testing_data[, pc_columns], type = "prob")
+    
+    # Calculate performance metrics
+    confusion_matrix <- confusionMatrix(predictions, testing_data$DX_GROUP)
+    
+    # Calculate AUC
+    roc_result <- roc(as.numeric(testing_data$DX_GROUP), prediction_probs[,1])
+    auc_value <- auc(roc_result)
+    
+    # Create results summary
+    svm_results <- data.frame(
+      Metric = c("Accuracy", "Sensitivity", "Specificity", "AUC"),
+      Value = c(
+        confusion_matrix$overall["Accuracy"],
+        confusion_matrix$byClass["Sensitivity"],
+        confusion_matrix$byClass["Specificity"],
+        auc_value
+      )
+    )
+    
+    safe_write_csv(svm_results, "svm_performance_results.csv", "07_svm")
+    safe_write_csv(as.data.frame(confusion_matrix$table), "svm_confusion_matrix.csv", "07_svm")
+    
+    cat("SVM classification completed successfully.\n")
+    cat("Accuracy:", round(confusion_matrix$overall["Accuracy"], 3), "\n")
+    cat("AUC:", round(auc_value, 3), "\n")
